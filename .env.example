# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Modelo usado para classificar e extrair os dados
MODELO_IA=claude-opus-5-5

# Encaminhamento por e-mail (opcional). Com Gmail: smtp.gmail.com, porta 587 e uma "senha de app".
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# Encaminhamento por webhook (opcional): URL de webhook de um canal do Discord, Teams ou Slack.
WEBHOOK_URL=

# De quanto em quanto tempo o robô olha a caixa de e-mail e a pasta de entrada (segundos)
INTERVALO_SEGUNDOS=20
